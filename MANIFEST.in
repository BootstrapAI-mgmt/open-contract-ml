# What the sdist carries beyond the package itself.
#
# setuptools already includes src/, pyproject.toml, README.md, LICENSE, NOTICE
# and tests/test*.py. Those test modules read example and fixture files, so the
# files they read ship too; without them the sdist's own suite cannot run. The
# two test modules that check the repository rather than the package -- every
# tracked file has a provenance record, no markdown link dangles -- need a git
# checkout of the whole repository, so they stay out of the sdist.
graft tests/fixtures
graft examples/reference-package
graft examples/brake_disc_tmf_v1
exclude tests/test_provenance.py
exclude tests/test_link_integrity.py
global-exclude *.py[cod]
