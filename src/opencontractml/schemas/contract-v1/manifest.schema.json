{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BootstrapAI-mgmt/open-contract-ml/schemas/contract-v1/manifest.schema.json",
  "title": "Contract v1 manifest",
  "description": "The machine contract of a contract package. A superset of cae-ml-gui manifest-spec 1.0: it adds `provenance` and `validation` and changes nothing existing, so a contract-v1 manifest is a valid gui-v1 manifest. Structural rules only -- the cross-field invariants (uncertainty.per_output coverage, the entrypoint/executable binding, hash verification) are in verify.py, which is the authority.",
  "type": "object",
  "required": [
    "spec_version", "id", "name", "version", "owner", "domain", "modality", "purpose",
    "inputs", "outputs", "uncertainty", "invocation", "lineage", "model_card",
    "provenance", "validation"
  ],
  "properties": {
    "spec_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "description": "Contract spec version as MAJOR.MINOR. A consumer rejects a higher MAJOR loudly and ignores unknown additive keys within a supported MAJOR."
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1, "description": "The model's own semver. Distinct from spec_version."},
    "owner": {
      "type": "object",
      "required": ["team", "contact"],
      "properties": {"team": {"type": "string", "minLength": 1}, "contact": {"type": "string", "minLength": 1}}
    },
    "domain": {"type": "string", "minLength": 1},
    "modality": {
      "type": "string",
      "enum": ["scalar_in_scalar_out", "tabular_in_scalar_out", "timeseries_in_scalar_out",
               "timeseries_in_timeseries_out", "geometry_in_scalar_out", "geometry_in_field_out",
               "field_in_field_out"]
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "analysis_type": {"type": "string"},
    "purpose": {"type": "string", "minLength": 1},
    "when_to_use": {"type": "string"},
    "when_not_to_use": {"type": "string"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "required"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["boolean", "categorical", "file", "float", "integer", "string"]},
          "units": {"type": "string"},
          "canonical_units": {"type": "string"},
          "range": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
          "choices": {"type": "array", "items": {"type": "string"}},
          "file_kind": {"type": "string", "enum": ["csv", "npz", "step", "stl", "vtk"]},
          "required": {"type": "boolean"},
          "description": {"type": "string"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "type", "viewer"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["categorical", "distribution", "field", "float", "integer", "timeseries"]},
          "units": {"type": "string"},
          "choices": {"type": "array", "items": {"type": "string"}},
          "viewer": {"type": "string", "minLength": 1}
        }
      }
    },
    "primary_inputs": {"type": "array", "items": {"type": "string"}},
    "primary_outputs": {"type": "array", "items": {"type": "string"}},
    "uncertainty": {
      "type": "object",
      "required": ["form", "per_output"],
      "properties": {
        "form": {"type": "string", "enum": ["class_probabilities", "ensemble", "monte_carlo",
                                            "predictive_interval", "quantiles"]},
        "per_output": {
          "type": "object",
          "minProperties": 1,
          "description": "One block per declared output. Coverage of every output is enforced by verify rule M007, which JSON Schema cannot express.",
          "additionalProperties": {"type": "object"}
        },
        "calibration": {"type": "object"}
      }
    },
    "invocation": {
      "type": "object",
      "required": ["executable", "protocol", "timeout_s"],
      "properties": {
        "executable": {"type": "string", "minLength": 1,
                       "description": "Must equal the path of the single role:entrypoint provenance artifact (rule M013)."},
        "protocol": {"const": "stdio_json", "description": "v1 supports stdio_json only."},
        "timeout_s": {"type": "integer", "exclusiveMinimum": 0},
        "expected_runtime_s": {"type": "number"},
        "batch_supported": {"type": "boolean"}
      }
    },
    "lineage": {
      "type": "object",
      "required": ["training_data_version", "training_date", "metrics"],
      "properties": {
        "training_data_version": {"type": "string"},
        "training_date": {"type": "string"},
        "metrics": {"type": "object"},
        "retrain_cadence": {"type": "string"}
      }
    },
    "model_card": {"type": "string", "minLength": 1, "description": "Relative path to the eleven-section model_card.md."},
    "provenance": {
      "type": "object",
      "required": ["artifacts", "dataset", "code"],
      "description": "New in contract v1. The card and the validation report are deliberately NOT listed here -- both are written after the artifacts they describe, so hashing them would be circular. They are bound by the model_id / version / dataset_sha256 triple instead.",
      "properties": {
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "role", "sha256", "bytes"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "role": {"type": "string", "enum": ["asset", "entrypoint", "weights"]},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        },
        "dataset": {
          "type": "object",
          "required": ["sha256"],
          "properties": {
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "n_samples": {"type": "integer", "minimum": 0},
            "generator_version": {"type": "string"},
            "solver_version": {"type": "string"}
          }
        },
        "code": {
          "type": "object",
          "required": ["repo", "commit"],
          "properties": {
            "repo": {"type": "string", "minLength": 1},
            "commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
            "version": {"type": "string"}
          }
        },
        "environment": {
          "type": "object",
          "properties": {"python": {"type": "string"}, "packages": {"type": "object"}}
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["report"],
      "description": "New in contract v1. Points at the tiered validation report.",
      "properties": {
        "report": {"type": "string", "minLength": 1},
        "overall": {"type": "string", "enum": ["PASS", "FAIL"]}
      }
    },
    "examples": {"type": "array", "items": {"type": "object"}}
  }
}
